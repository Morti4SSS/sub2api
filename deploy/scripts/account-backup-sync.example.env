# Copy to account-backup-sync.env and fill secrets locally.

# Example: https://sub2api.example.com
SUB2API_BASE_URL=

# Prefer Admin API Key because it is stable for scheduled tasks.
# Backend admin auth accepts this as x-api-key.
SUB2API_ADMIN_API_KEY=

# Alternative to SUB2API_ADMIN_API_KEY.
SUB2API_BEARER_TOKEN=

# Local-only private key path. Do not upload this key to the VPS.
ACCOUNT_BACKUP_PRIVATE_KEY_FILE=C:\sub2api-backup\account_backup_private.pem

# Local folders for decrypted JSON and encrypted cache.
ACCOUNT_BACKUP_OUTPUT_DIR=C:\sub2api-backup\json
ACCOUNT_BACKUP_ENCRYPTED_DIR=C:\sub2api-backup\encrypted

# Keep latest 10 decrypted JSON backups locally.
ACCOUNT_BACKUP_RETAIN_COUNT=10
